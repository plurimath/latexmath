    / (slash ("int") as ternary_functions (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript) [(sequence__comma) as third_value]) as ternary_class
    / slash ("int") as ternary
    / (slash ("log") as binary (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)) as power_base
    / slash ("log") as binary
    / (slash ("lim") as binary (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)) as power_base
    / slash ("lim") as binary
    / (slash ("inf") as binary (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)) as power_base
    / slash ("inf") as binary
  }
  symbol_class_commands_part12__arabic = {
      (slash ("hat") as unary (left_right__arabic) as first_value) as unary_functions
    / (slash ("hat") as unary (intermediate_exp__arabic) as first_value) as unary_functions
    / slash ("hat") as unary
    / slash ("Bbb") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / slash ("mtt") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / slash ("mbf") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / slash ("mit") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / slash ("cal") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / (slash ("int") as ternary_functions (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript) [(sequence__arabic) as third_value]) as ternary_class
    / slash ("int") as ternary
    / (slash ("log") as binary (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)) as power_base
    / slash ("log") as binary
    / (slash ("lim") as binary (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)) as power_base
    / slash ("lim") as binary
    / (slash ("inf") as binary (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)) as power_base
    / slash ("inf") as binary
  }
  symbol_class_commands_part13__dot = {
      (slash ("sum") as ternary_functions (base (intermediate_exp__dot) as subscript power (intermediate_exp__dot) as supscript / power (intermediate_exp__dot) as supscript base (intermediate_exp__dot) as subscript / power (intermediate_exp__dot) as supscript / base (intermediate_exp__dot) as subscript) [(sequence__dot) as third_value]) as ternary_class
    / slash ("sum") as ternary
    / slash ("bar") as unary_functions (base (intermediate_exp__dot) as subscript power (intermediate_exp__dot) as supscript / power (intermediate_exp__dot) as supscript base (intermediate_exp__dot) as subscript / power (intermediate_exp__dot) as supscript / base (intermediate_exp__dot) as subscript)
    / (slash ("bar") as unary (left_right__dot) as first_value) as unary_functions
    / (slash ("bar") as unary (intermediate_exp__dot) as first_value) as unary_functions
    / symbol_class_commands_run11
    / slash ("bf") as fonts (binary_functions__dot / intermediate_exp__dot) as intermediate_exp
    / slash ("lg") as unary_functions (base (intermediate_exp__dot) as subscript power (intermediate_exp__dot) as supscript / power (intermediate_exp__dot) as supscript base (intermediate_exp__dot) as subscript / power (intermediate_exp__dot) as supscript / base (intermediate_exp__dot) as subscript)
    / (slash ("lg") as unary (left_right__dot) as first_value) as unary_functions
    / (slash ("lg") as unary (intermediate_exp__dot) as first_value) as unary_functions
    / slash ("lg") as unary
    / slash ("ln") as unary_functions (base (intermediate_exp__dot) as subscript power (intermediate_exp__dot) as supscript / power (intermediate_exp__dot) as supscript base (intermediate_exp__dot) as subscript / power (intermediate_exp__dot) as supscript / base (intermediate_exp__dot) as subscript)
    / (slash ("ln") as unary (left_right__dot) as first_value) as unary_functions
    / (slash ("ln") as unary (intermediate_exp__dot) as first_value) as unary_functions
    / slash ("ln") as unary
    / slash ("rm") as fonts (binary_functions__dot / intermediate_exp__dot) as intermediate_exp
  }
  symbol_class_commands_part13__comma = {
      (slash ("sum") as ternary_functions (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript) [(sequence__comma) as third_value]) as ternary_class
    / slash ("sum") as ternary
    / slash ("bar") as unary_functions (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)
    / (slash ("bar") as unary (left_right__comma) as first_value) as unary_functions
    / (slash ("bar") as unary (intermediate_exp__comma) as first_value) as unary_functions
    / symbol_class_commands_run11
    / slash ("bf") as fonts (binary_functions__comma / intermediate_exp__comma) as intermediate_exp
    / slash ("lg") as unary_functions (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)
    / (slash ("lg") as unary (left_right__comma) as first_value) as unary_functions
    / (slash ("lg") as unary (intermediate_exp__comma) as first_value) as unary_functions
    / slash ("lg") as unary
    / slash ("ln") as unary_functions (base (intermediate_exp__comma) as subscript power (intermediate_exp__comma) as supscript / power (intermediate_exp__comma) as supscript base (intermediate_exp__comma) as subscript / power (intermediate_exp__comma) as supscript / base (intermediate_exp__comma) as subscript)
    / (slash ("ln") as unary (left_right__comma) as first_value) as unary_functions
    / (slash ("ln") as unary (intermediate_exp__comma) as first_value) as unary_functions
    / slash ("ln") as unary
    / slash ("rm") as fonts (binary_functions__comma / intermediate_exp__comma) as intermediate_exp
  }
  symbol_class_commands_part13__arabic = {
      (slash ("sum") as ternary_functions (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript) [(sequence__arabic) as third_value]) as ternary_class
    / slash ("sum") as ternary
    / slash ("bar") as unary_functions (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)
    / (slash ("bar") as unary (left_right__arabic) as first_value) as unary_functions
    / (slash ("bar") as unary (intermediate_exp__arabic) as first_value) as unary_functions
    / symbol_class_commands_run11
    / slash ("bf") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
    / slash ("lg") as unary_functions (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)
    / (slash ("lg") as unary (left_right__arabic) as first_value) as unary_functions
    / (slash ("lg") as unary (intermediate_exp__arabic) as first_value) as unary_functions
    / slash ("lg") as unary
    / slash ("ln") as unary_functions (base (intermediate_exp__arabic) as subscript power (intermediate_exp__arabic) as supscript / power (intermediate_exp__arabic) as supscript base (intermediate_exp__arabic) as subscript / power (intermediate_exp__arabic) as supscript / base (intermediate_exp__arabic) as subscript)
    / (slash ("ln") as unary (left_right__arabic) as first_value) as unary_functions
    / (slash ("ln") as unary (intermediate_exp__arabic) as first_value) as unary_functions
    / slash ("ln") as unary
    / slash ("rm") as fonts (binary_functions__arabic / intermediate_exp__arabic) as intermediate_exp
  }
  slash = "\\"
  binary_functions__dot = {
      ((intermediate_exp__dot) as first_value under_over (intermediate_exp__dot) as second_value) as under_over
    / (slash ("sqrt") as root (sqrt_arg__dot) as first_value (intermediate_exp__dot) as second_value) as binary
    / (slash ("sqrt") as sqrt (intermediate_exp__dot) as intermediate_exp) as binary
    / "{" slash ("color") as binary (color) as first_value [(sequence__dot [iteration__dot]) as second_value] "}"
    / slash ("color") as binary (color) as first_value [(expression__dot) as second_value]
  }
  binary_functions__comma = {
      ((intermediate_exp__comma) as first_value under_over (intermediate_exp__comma) as second_value) as under_over
    / (slash ("sqrt") as root (sqrt_arg__comma) as first_value (intermediate_exp__comma) as second_value) as binary
    / (slash ("sqrt") as sqrt (intermediate_exp__comma) as intermediate_exp) as binary
    / "{" slash ("color") as binary (color) as first_value [(sequence__comma [iteration__comma]) as second_value] "}"
    / slash ("color") as binary (color) as first_value [(expression__comma) as second_value]
  }
  binary_functions__arabic = {
      ((intermediate_exp__arabic) as first_value under_over (intermediate_exp__arabic) as second_value) as under_over
    / (slash ("sqrt") as root (sqrt_arg__arabic) as first_value (intermediate_exp__arabic) as second_value) as binary
    / (slash ("sqrt") as sqrt (intermediate_exp__arabic) as intermediate_exp) as binary
    / "{" slash ("color") as binary (color) as first_value [(sequence__arabic [iteration__arabic]) as second_value] "}"
    / slash ("color") as binary (color) as first_value [(expression__arabic) as second_value]
  }
  intermediate_exp__dot = {
      ((lparen) as left_paren ([expression__dot]) as expression ([(rparen / (slash [[%x20] "."]) as rparen)]) as right_paren) as intermediate_exp
    / "{" ([expression__dot]) as expression "}"
    / symbol_text_or_integer__dot
  }
  intermediate_exp__comma = {
      ((lparen) as left_paren ([expression__comma]) as expression ([(rparen / (slash [[%x20] "."]) as rparen)]) as right_paren) as intermediate_exp
    / "{" ([expression__comma]) as expression "}"
    / symbol_text_or_integer__comma
  }
  intermediate_exp__arabic = {
      ((lparen) as left_paren ([expression__arabic]) as expression ([(rparen / (slash [[%x20] "."]) as rparen)]) as right_paren) as intermediate_exp
    / "{" ([expression__arabic]) as expression "}"
    / symbol_text_or_integer__arabic
  }
  lparen = lparen_part1 / lparen_part2 / lparen_part3
  lparen_part1 = {
      ("\\text{P[lceiling]}") as lparen
    / ("\\text{P[&#x27e8;]}") as lparen
    / ("\\text{P[rbbrack]}") as lparen
    / ("\\text{P[lbbrack]}") as lparen
    / ("\\text{P[Rbrack]}") as lparen
    / ("\\text{P[Langle]}") as lparen
    / ("\\text{P[Lbrack]}") as lparen
    / ("\\text{P[begin]}") as lparen
    / ("\\text{P[norm]}") as lparen
    / ("\\text{P[bra]}") as lparen
    / ("\\text{P[|__]}") as lparen
    / ("\\text{P[end]}") as lparen
    / ("\\text{P[{:]}") as lparen
    / ("\\text{P[:}]}") as lparen
    / ("\\text{P[(:]}") as lparen
    / ("\\text{P[<<]}") as lparen
  }
  lparen_part2 = {
      ("\\text{P[|~]}") as lparen
    / ("&#x3017;") as lparen
    / ("&#x2016;") as lparen
    / ("&#x3016;") as lparen
    / ("&#x230a;") as lparen
    / ("&#x2308;") as lparen
    / ("&#x2329;") as lparen
    / ("&#x27eb;") as lparen
    / ("&#x27ea;") as lparen
    / ("&#x27e7;") as lparen
    / ("&#x27e6;") as lparen
    / ("\\lbrack") as lparen
    / ("\\lbrace") as lparen
    / ("\\lfloor") as lparen
    / ("\\langle") as lparen
    / ("&#x7b;") as lparen
  }
  lparen_part3 = {
      ("&#x5b;") as lparen
    / ("\\lceil") as lparen
    / ("\\Vert") as lparen
    / ("\\{") as lparen
    / ("\\[") as lparen
    / ("\\(") as lparen
    / ("(") as lparen
    / ("[") as lparen
  }
  under_over = slash underover_classes
  underover_classes = ("bmod") as binary / ("pmod") as binary / ("mod") as binary
  sqrt_arg__dot = ("[") as lparen (1*(intermediate_exp__dot)) as expression ("]") as rparen / ("[") as lparen ("]") as rparen
  sqrt_arg__comma = ("[") as lparen (1*(intermediate_exp__comma)) as expression ("]") as rparen / ("[") as lparen ("]") as rparen
  sqrt_arg__arabic = ("[") as lparen (1*(intermediate_exp__arabic)) as expression ("]") as rparen / ("[") as lparen ("]") as rparen
  color = "{" (*(!("}") any_char)) as symbol "}" / (any_char) as symbol
  base = "_"
  power = "^"
  left_right__dot = ("\\left") as left (left_parens / ["."]) ((*(expression__dot)) as dividend "\\over" (*(expression__dot)) as divisor / [(expression__dot) as expression]) [("\\right") as right] (right_parens / ["."])
  left_right__comma = ("\\left") as left (left_parens / ["."]) ((*(expression__comma)) as dividend "\\over" (*(expression__comma)) as divisor / [(expression__comma) as expression]) [("\\right") as right] (right_parens / ["."])
  left_right__arabic = ("\\left") as left (left_parens / ["."]) ((*(expression__arabic)) as dividend "\\over" (*(expression__arabic)) as divisor / [(expression__arabic) as expression]) [("\\right") as right] (right_parens / ["."])
  left_parens = left_parens_part1 / left_parens_part2
  left_parens_part1 = {
      ("\\backslash") as left_paren
    / ("\\langle") as left_paren
    / ("\\rangle") as left_paren
    / ("\\lfloor") as left_paren
    / ("\\rfloor") as left_paren
    / ("\\lceil") as left_paren
    / ("\\rceil") as left_paren
    / ("\\lbrace") as left_paren
    / ("\\rbrace") as left_paren
    / ("\\lbrack") as left_paren
    / ("\\rbrack") as left_paren
    / ("\\Vert") as left_paren
    / ("\\vert") as left_paren
    / ("\\|") as left_paren
    / ("\\}") as left_paren
    / ("\\{") as left_paren
  }
  left_parens_part2 = {
      ("(") as left_paren
    / (")") as left_paren
    / ("<") as left_paren
    / (">") as left_paren
    / ("/") as left_paren
    / ("|") as left_paren
    / ("[") as left_paren
    / ("]") as left_paren
  }
  right_parens = right_parens_part1 / right_parens_part2
  right_parens_part1 = {
      ("\\backslash") as right_paren
    / ("\\langle") as right_paren
    / ("\\rangle") as right_paren
    / ("\\lfloor") as right_paren
    / ("\\rfloor") as right_paren
    / ("\\lceil") as right_paren
    / ("\\rceil") as right_paren
    / ("\\lbrace") as right_paren
    / ("\\rbrace") as right_paren
    / ("\\lbrack") as right_paren
    / ("\\rbrack") as right_paren
    / ("\\Vert") as right_paren
    / ("\\vert") as right_paren
    / ("\\|") as right_paren
    / ("\\}") as right_paren
    / ("\\{") as right_paren
  }
  right_parens_part2 = {
      ("(") as right_paren
    / (")") as right_paren
    / ("<") as right_paren
    / (">") as right_paren
    / ("/") as right_paren
    / ("|") as right_paren
    / ("[") as right_paren
    / ("]") as right_paren
  }
  parsing_text_values = {
      "{" parsing_text_values "}" parsing_text_values
    / "{" parsing_text_values "}"
    / not_rbrace parsing_text_values
    / *(not_rbrace)
  }
  environment = {
      ("multline") as environment
    / ("Vmatrix") as environment
    / ("vmatrix") as environment
    / ("pmatrix") as environment
    / ("Bmatrix") as environment
    / ("bmatrix") as environment
    / ("matrix") as environment
    / ("split") as environment
    / ("align") as environment
    / ("array") as environment
  }
  numeric_values = {
      ("zero") as numeric_values
    / ("one") as numeric_values
    / ("two") as numeric_values
    / ("three") as numeric_values
    / ("four") as numeric_values
    / ("five") as numeric_values
    / ("six") as numeric_values
    / ("seven") as numeric_values
    / ("eight") as numeric_values
    / ("nine") as numeric_values
  }
  math_operators_classes = math_operators_classes_part1 / math_operators_classes_part2
  math_operators_classes_part1 = {
      ("liminf") as unary_functions
    / ("arctan") as unary_functions
    / ("arcsin") as unary_functions
    / ("limsup") as unary_functions
    / ("tanh") as unary_functions
    / ("coth") as unary_functions
    / ("cosh") as unary_functions
    / ("sinh") as unary_functions
    / ("int") as unary_functions
    / ("sin") as unary_functions
    / ("max") as unary_functions
    / ("dim") as unary_functions
    / ("arg") as unary_functions
    / ("tan") as unary_functions
    / ("sec") as unary_functions
    / ("log") as unary_functions
  }
  math_operators_classes_part2 = {
      ("hom") as unary_functions
    / ("det") as unary_functions
    / ("cot") as unary_functions
    / ("gcd") as unary_functions
    / ("deg") as unary_functions
    / ("min") as unary_functions
    / ("ker") as unary_functions
    / ("exp") as unary_functions
    / ("csc") as unary_functions
    / ("cos") as unary_functions
    / ("Pr") as unary_functions
    / ("ln") as unary_functions
    / ("lg") as unary_functions
  }
  hex_number = ("0x" / "0X") (1*(hex_digit)) as hex_number
  binary_number = ("0b" / "0B") (1*(%x30-31)) as binary_number
  octal_number = ("0o" / "0O") (1*(%x30-37)) as octal_number
  over_class__dot = ("{" (*(expression__dot)) as dividend "\\over" (*(expression__dot)) as divisor "}" / ((left_right__dot) as left_right) as power power intermediate_exp__dot / ((left_right__dot) as left_right) as base base intermediate_exp__dot) as over
  over_class__comma = ("{" (*(expression__comma)) as dividend "\\over" (*(expression__comma)) as divisor "}" / ((left_right__comma) as left_right) as power power intermediate_exp__comma / ((left_right__comma) as left_right) as base base intermediate_exp__comma) as over
  over_class__arabic = ("{" (*(expression__arabic)) as dividend "\\over" (*(expression__arabic)) as divisor "}" / ((left_right__arabic) as left_right) as power power intermediate_exp__arabic / ((left_right__arabic) as left_right) as base base intermediate_exp__arabic) as over
  array_begin = "\\begin{" ("array") as environment "}"
  array_args__dot = "{" (expression__dot) as args "}"
  array_args__comma = "{" (expression__comma) as args "}"
  array_args__arabic = "{" (expression__arabic) as args "}"
  ending__dot = (slash "end{" symbol_text_or_integer__dot ["*"] "}") as ending
  ending__comma = (slash "end{" symbol_text_or_integer__comma ["*"] "}") as ending
  ending__arabic = (slash "end{" symbol_text_or_integer__arabic ["*"] "}") as ending
  begining__dot = slash "begin{" symbol_text_or_integer__dot ("*") as asterisk "}" [optional_args__dot] / slash "begin{" symbol_text_or_integer__dot "}"
  begining__comma = slash "begin{" symbol_text_or_integer__comma ("*") as asterisk "}" [optional_args__comma] / slash "begin{" symbol_text_or_integer__comma "}"
  begining__arabic = slash "begin{" symbol_text_or_integer__arabic ("*") as asterisk "}" [optional_args__arabic] / slash "begin{" symbol_text_or_integer__arabic "}"
  optional_args__dot = ["[" ([intermediate_exp__dot]) as options "]"]
  optional_args__comma = ["[" ([intermediate_exp__comma]) as options "]"]
  optional_args__arabic = ["[" ([intermediate_exp__arabic]) as options "]"]
  power_base__dot = {
      (subscript__dot power (intermediate_exp__dot) as supscript) as power_base
    / (supscript__dot base (intermediate_exp__dot) as subscript) as power_base
    / (supscript__dot) as power
    / (subscript__dot) as base
  }
  power_base__comma = {
      (subscript__comma power (intermediate_exp__comma) as supscript) as power_base
    / (supscript__comma base (intermediate_exp__comma) as subscript) as power_base
    / (supscript__comma) as power
    / (subscript__comma) as base
  }
  power_base__arabic = {
      (subscript__arabic power (intermediate_exp__arabic) as supscript) as power_base
    / (supscript__arabic base (intermediate_exp__arabic) as subscript) as power_base
    / (supscript__arabic) as power
    / (subscript__arabic) as base
  }
  subscript__dot = intermediate_exp__dot base (intermediate_exp__dot) as subscript
  subscript__comma = intermediate_exp__comma base (intermediate_exp__comma) as subscript
  subscript__arabic = intermediate_exp__arabic base (intermediate_exp__arabic) as subscript
  supscript__dot = intermediate_exp__dot power (intermediate_exp__dot) as supscript
  supscript__comma = intermediate_exp__comma power (intermediate_exp__comma) as supscript
  supscript__arabic = intermediate_exp__arabic power (intermediate_exp__arabic) as supscript

  # ---- character classes (no Plurimath rule of their own) ----
  # match(".")
  any_char = %x00-10FFFF
  # match("[a-zA-Z]")
  ascii_letter = %x41-5A / %x61-7A
  # match("[0-9a-fA-F]")
  hex_digit = %x30-39 / %x41-46 / %x61-66
  # match("[^}]")
  not_rbrace = %x00-7C / %x7E-10FFFF
  # match("(?-mix:\\s)")
  white_space = %x09-0D / %x20 / %x85 / %xA0 / %x1680 / %x2000-200A / %x2028-2029 / %x202F / %x205F / %x3000

  # ---- the tree capture each entry starts from ----
  latex_tree__dot = (expression__dot) as latex_tree
  latex_tree__comma = (expression__comma) as latex_tree
  latex_tree__arabic = (expression__arabic) as latex_tree
}

entry dot: latex_tree__dot
entry comma: latex_tree__comma
entry arabic: latex_tree__arabic

bindings latex_tree__dot {
  latex_tree -> latex_tree (raw)
}

bindings latex_tree__comma {
  latex_tree -> latex_tree (raw)
}

bindings latex_tree__arabic {
  latex_tree -> latex_tree (raw)
}
